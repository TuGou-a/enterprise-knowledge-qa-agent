# 架构配置草案；业务工程尚未接入这些变量。
# 由终端、IDE 或容器注入；Spring Boot 不会默认自动读取本文件。
DEEPSEEK_API_KEY=
# 下列基础地址与模型名由应用读取后显式传给 Provider。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 建议初值；实际调用超时同时受当前请求剩余预算约束。
RERANK_TIMEOUT_MS=10000

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowledge_agent
SPRING_DATASOURCE_USERNAME=knowledge_agent
SPRING_DATASOURCE_PASSWORD=
