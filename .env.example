# T01 真实模式配置；由终端、IDE 或容器显式注入，不会自动加载。
# 三项密钥/密码必填；未填写时启动校验失败。禁止提交实际值。
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
SPRING_DATASOURCE_PASSWORD=

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/knowledge_agent
SPRING_DATASOURCE_USERNAME=knowledge_agent
DB_CONNECTION_TIMEOUT_MS=2000
DATABASE_TIMEOUT_MS=5000

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 模型可用性已验证；窗口与 token 消耗仍按应用侧保守预算处理。
DEEPSEEK_CONTEXT_WINDOW=32768
DEEPSEEK_MAX_OUTPUT_TOKENS=2048
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TEXT_CHARACTERS=4000
RERANK_CHARACTERS=64000

RETRIEVAL_ROUTE_LIMIT=20
RETRIEVAL_POOL_LIMIT=20
RETRIEVAL_PRIMARY_LIMIT=6
RETRIEVAL_RELATED_LIMIT=12
RETRIEVAL_RRF_K=60
RETRIEVAL_PREVIEW_CHARACTERS=300

QA_QUESTION_CHARACTERS=2000
QA_HISTORY_MESSAGES=20
QA_HISTORY_MESSAGE_CHARACTERS=4000
QA_HISTORY_CHARACTERS=12000
QA_QUERY_CHARACTERS=512
QA_MODEL_INPUT_CHARACTERS=24000
QA_READ_CHARACTERS=20000
QA_TOOL_TEXT_CHARACTERS=24000
QA_REACT_ITERATIONS=6
QA_TOOL_CALLS=12
QA_REQUEST_TIMEOUT_MS=120000
MODEL_TIMEOUT_MS=60000
TOOL_TIMEOUT_MS=30000
EMBEDDING_TIMEOUT_MS=15000
RERANK_TIMEOUT_MS=10000

# 修改 Embedding、预处理、分词器或词典/停用词内容后须更新配置标识并建立新快照。
INDEX_PREPROCESSING_VERSION=source-preserving-v1
JIEBA_TOKENIZER_VERSION=jieba-analysis-1.0.2
JIEBA_DICTIONARY_VERSION=builtin-v1
JIEBA_STOP_WORDS_VERSION=none-v1
JIEBA_DICTIONARY_LOCATION=
JIEBA_STOP_WORDS_LOCATION=
